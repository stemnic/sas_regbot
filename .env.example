# Provider: oxylabs (default) | brightdata
PROXY_PROVIDER=oxylabs
PROXY_USERNAME=scraper2_3mi9y
PROXY_PASSWORD=
PROXY_HOST=dc.oxylabs.io
# Prefer US pool: username becomes user-USERNAME-country-US
# https://developers.oxylabs.io/products/proxies/datacenter-proxies/select-country
OXYLABS_COUNTRY=US

# Pay-per-traffic Datacenter: sticky session = random port in this range (Oxylabs docs)
# curl -x dc.oxylabs.io:35467 -U "user-USERNAME:PASSWORD" https://ip.oxylabs.io/location
OXYLABS_PORT_MIN=8001
OXYLABS_PORT_MAX=63000
# Optional pin for debug (same sticky port every run)
# OXYLABS_PORT=35467
# Legacy fixed port list (only if needed):
# OXYLABS_USE_PORT_LIST=true
# OXYLABS_PORTS=8001,8002,8003,8004,8005
# REGBOT_PROXY_STATE_PATH=data/oxy_port_state.json

# CapSolver — Playwright + extension captcha (default on oxylabs)
CAPSOLVER_API_KEY=
REGBOT_CAPTCHA_MODE=playwright
REGBOT_PLAYWRIGHT_BROWSER_PROXY=true
# Layer C: enroll from same Playwright page (not curl)
# REGBOT_ENROLL_VIA=page
# Servers without display: xvfb-run -a uv run regbot register ...

# Mullvad: require Connected + bind host requests to WG IP (CapSolver/OpenInbox/Google)
# SAS still egresses via Oxylabs; OS default route is Mullvad when Connected.
REGBOT_REQUIRE_MULLVAD=true
REGBOT_BIND_INTERFACE=wg0-mullvad
# REGBOT_MULLVAD_BIN=mullvad
# Optional slow exit probe (default off — avoids 12s curl timeouts on am.i.mullvad)
# REGBOT_MULLVAD_PROBE_EXIT=false
# Optional curl_cffi interface= on Oxylabs CONNECT (default off; can hang)
# REGBOT_CURL_BIND_INTERFACE=false
# Fail-fast dead proxy port (seconds)
# REGBOT_PROXY_IP_TIMEOUT_S=15

# Email — OpenInbox automatic OTP (https://openinbox.io/api-docs)
EMAIL_PROVIDER=openinbox
OPENINBOX_API_KEY=
# OPENINBOX_BASE_URL=https://api.openinbox.io/api
# OPENINBOX_DOMAIN=
# On concurrent limit: free only the oldest inbox once (keep rest for late mail)
# REGBOT_OPENINBOX_PRUNE_OLDEST=true

# Daily automation (regbot daily) — one account per run; space via cron
# REGBOT_DAILY_TARGET=5
# REGBOT_DAILY_BATCH=1
# REGBOT_PROXY_RETRIES=3
# REGBOT_CAPTCHA_RETRIES=1
# REGBOT_CIRCUIT_CONSEC_FAIL=3
# REGBOT_DAILY_STATE_PATH=data/daily_state.json

# Circuit-open alerts via Forward Email (https://forwardemail.net/en/email-api)
# FORWARDEMAIL_API_KEY=
# REG_ALERT_FROM=reg-infra@polarawards.com
# REG_ALERT_TO=reg-alerts@polarawards.com
# REG_ALERT_ENABLED=true
#
# Space ~5 attempts through the day (UTC), one account each:
# 0 8,11,14,17,20 * * * cd /home/stemnic/regbot && xvfb-run -a uv run regbot daily -v --debug >> data/logs/daily.log 2>&1
