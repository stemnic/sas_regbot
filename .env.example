# Provider: oxylabs (default) | brightdata
PROXY_PROVIDER=oxylabs
PROXY_USERNAME=scraper2_3mi9y
PROXY_PASSWORD=
PROXY_HOST=dc.oxylabs.io
# Rotate across these ports (one sticky port per registration attempt)
OXYLABS_PORTS=8001,8002,8003,8004,8005
# Optional pin for debug only (disables rotation). Leave unset to rotate.
# OXYLABS_PORT=8001
# roundrobin (default, persisted in data/oxy_port_state.json) | random (never reuse last)
# REGBOT_PROXY_ROTATE=roundrobin
# REGBOT_PROXY_STATE_PATH=data/oxy_port_state.json

# CapSolver — Playwright + extension captcha (default on oxylabs)
CAPSOLVER_API_KEY=
REGBOT_CAPTCHA_MODE=playwright
REGBOT_PLAYWRIGHT_BROWSER_PROXY=true
# Layer C: enroll from same Playwright page (not curl)
# REGBOT_ENROLL_VIA=page
# Servers without display: xvfb-run -a uv run regbot register ...

# Email — OpenInbox automatic OTP (https://openinbox.io/api-docs)
EMAIL_PROVIDER=openinbox
OPENINBOX_API_KEY=
# OPENINBOX_BASE_URL=https://api.openinbox.io/api
# OPENINBOX_DOMAIN=

# Optional AnyMessage fallback
# EMAIL_PROVIDER=anymessage
# ANYMESSAGE_TOKEN=
# ANYMESSAGE_SITE=flysas.com
