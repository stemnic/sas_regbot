# Provider: oxylabs (default) | brightdata
PROXY_PROVIDER=oxylabs
PROXY_USERNAME=scraper2_3mi9y
PROXY_PASSWORD=
PROXY_HOST=dc.oxylabs.io
OXYLABS_PORTS=8001,8002,8003,8004,8005
# Default pin is 8001 (manual success). Set OXYLABS_PORT= empty to rotate ports.
OXYLABS_PORT=8001

# CapSolver — HTTP tokens rejected by SAS; oxylabs default is Playwright + extension
CAPSOLVER_API_KEY=
# playwright (default on oxylabs) | proxy (HTTP debug only) | manual
REGBOT_CAPTCHA_MODE=playwright
REGBOT_PLAYWRIGHT_BROWSER_PROXY=true
# Defaults: synthetic host, direct Google, extension token mode (no auto checkbox click)
# REGBOT_PLAYWRIGHT_SYNTHETIC_FIRST=true
# REGBOT_PLAYWRIGHT_DIRECT_GOOGLE=true
# REGBOT_EXTENSION_RECAPTCHA_MODE=token
# REGBOT_PLAYWRIGHT_CLICK_CHECKBOX=false
# REGBOT_PLAYWRIGHT_API_INJECT_FALLBACK=true
# REGBOT_EXTENSION_USE_PROXY=false
# Layer C: enroll from Playwright (page) not curl — required after captcha works but curl 1015001
# REGBOT_ENROLL_VIA=page

# Chrome UA for browser + enroll TLS (chrome146)
# REGBOT_CAPTCHA_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/146.0.0.0 Safari/537.36
# REGBOT_REFRESH_TOKEN_EACH_ENROLL=false
# Servers without display: xvfb-run -a uv run regbot register ...

# Email
EMAIL_PROVIDER=manual
